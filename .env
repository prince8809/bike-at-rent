# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bike_at_rent?sslmode=disable
DATABASE_POOL_SIZE=10
DATABASE_MAX_IDLE_CONNS=2
DATABASE_CONN_MAX_LIFE=1h

# Server
SERVER_PORT=8080
LOG_LEVEL=debug

# JWT
JWT_SECRET=supersecretmockvalue0123456789
JWT_ISSUER=bikeatrent
JWT_EXPIRES_IN=3600
REFRESH_EXPIRES_IN=604800

# Redis (optional)
REDIS_URL=redis://localhost:6379/0

# SMS / misc
SMS_SENDER_ID=BIKEAT