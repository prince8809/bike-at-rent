# Example environment file for BikeAtRent
# Copy to .env and update values before running migrations or starting the app

# PostgreSQL connection URL format:
# postgres://<username>:<password>@<host>:<port>/<database>?sslmode=disable

# Example for a local Docker Postgres container:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/bike_at_rent?sslmode=disable

# Optional: tune pool size used by the app (overrides defaults in config if set)
# DATABASE_POOL_SIZE=10
# DATABASE_MAX_IDLE_CONNS=2
# DATABASE_CONN_MAX_LIFE=1h
